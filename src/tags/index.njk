---
layout: base
title: Tags
permalink: /tags/
---

<div class="space-y-6">

  {% if collections.tagList and collections.tagList.length > 0 %}

    <div class="flex flex-wrap gap-3">
      {% for tag in collections.tagList %}
        <a
          href="/tags/{{ tag | urlencode }}/"
          class="inline-block px-3 py-1 rounded-full bg-gray-800 text-blue-400 hover:bg-gray-700 hover:text-white"
        >
          #{{ tag }}
        </a>
      {% endfor %}
    </div>

  {% else %}

    <p class="text-gray-400">
      No tags have been created yet.
    </p>

  {% endif %}

</div>

{% for tag in collections.tagList %}

  {% set tagPages = collections.published | filterByTag(tag) %}

  <div class="hidden">
    {{ tagPages | length }}
  </div>

{% endfor %}