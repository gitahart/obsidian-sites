<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{{ title | default(page.fileSlug) }}</title>

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-900 text-gray-200 min-h-screen">

  <header class="border-b border-gray-700">
    <div class="max-w-2xl mx-auto p-4 flex justify-between items-center">

      <a
        href="/"
        class="text-xl font-bold text-white hover:text-gray-300"
      >
        My Notes
      </a>

      <nav class="text-sm space-x-4 text-gray-400">
        <a href="/" class="hover:text-white">Home</a>
        <a href="/notes/" class="hover:text-white">Notes</a>
        <a href="/posts/" class="hover:text-white">Posts</a>
        <a href="/tags/" class="hover:text-white">Tags</a>
      </nav>

    </div>
  </header>

  <main class="max-w-2xl mx-auto p-4">

    <article class="space-y-4">

      {% if title %}
        <h1 class="text-2xl font-bold text-white">
          {{ title }}
        </h1>
      {% endif %}

      <div class="prose prose-invert max-w-none">

        {{
          content
          | wikilinks
          | inlineTags
          | autoLinks
          | safe
        }}

      </div>

    </article>

  </main>

  <footer class="border-t border-gray-700 mt-12">
    <div class="max-w-2xl mx-auto p-4 text-sm text-gray-500">
      Built with Eleventy
    </div>
  </footer>

</body>
</html>